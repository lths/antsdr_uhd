CONFIG_BOOTDELAY=2
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="mmc dev 0; if fatload mmc 0 0x2000000 uEnv.txt; then env import -t 0x2000000 ${filesize}; fi; run sdboot"
