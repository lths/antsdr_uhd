CONFIG_USE_PREBOOT=y
CONFIG_SYS_PBSIZE=2071
CONFIG_CLOCKS=y
# CONFIG_SPL_SHARES_INIT_SP_ADDR is not set
CONFIG_SYS_SPI_U_BOOT_OFFS=0x100000
