#!/bin/sh
set -eu
pid=/run/antsdr-health.pid
case "${1:-}" in
 start)
    start-stop-daemon --start --quiet --oknodo --background --make-pidfile \
        --pidfile "$pid" --exec /usr/sbin/antsdr-health -- --supervise
    ;;
 stop)
    start-stop-daemon --stop --quiet --oknodo --pidfile "$pid" --exec /usr/sbin/antsdr-health
    attempt=0
    while start-stop-daemon --stop --test --quiet --pidfile "$pid" --exec /usr/sbin/antsdr-health; do
        attempt=$((attempt+1)); [ "$attempt" -lt 5 ] || exit 1
        sleep 1
    done
    rm -f "$pid"
    ;;
 restart) "$0" stop; "$0" start ;;
 status) start-stop-daemon --stop --test --quiet --pidfile "$pid" --exec /usr/sbin/antsdr-health ;;
 *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
