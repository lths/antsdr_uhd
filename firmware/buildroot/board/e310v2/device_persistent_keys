#!/bin/sh
set -e
. /usr/lib/antsdr/persistence.sh
persist_require
persist_lock
umask 077
KEYFILE=/etc/dropbear/dropbear_ecdsa_host_key
if [ ! -f "$KEYFILE" ]; then
	dropbearkey -t ecdsa -f "$KEYFILE"
fi
persist_begin dropbear
for key in /etc/dropbear/dropbear_*_host_key; do
	[ -f "$key" ] || continue
	install -m 0600 "$key" "$SNAPSHOT/"
done
(cd "$SNAPSHOT" && md5sum dropbear_*_host_key > keys.md5)
persist_publish

if [ -f /root/.ssh/authorized_keys ]; then
	persist_begin authorized_keys
	install -m 0600 /root/.ssh/authorized_keys "$SNAPSHOT/"
	(cd "$SNAPSHOT" && md5sum authorized_keys > keys.md5)
	persist_publish
fi
